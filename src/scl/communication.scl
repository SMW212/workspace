    RETURN := TRUE;
END_FUNCTION

// Type definitions
TYPE "CommStatusEnum" : INT
  DISCONNECTED := 0;
  CONNECTING := 1;
  CONNECTED := 2;
  ERROR := 3;
  TIMEOUT := 4;
END_TYPE

TYPE "ModbusStateEnum" : INT
  IDLE := 0;
  SENDING := 1;
  WAITING := 2;
  RECEIVING := 3;
  PROCESSING := 4;
END_TYPE
